#!/bin/bash

set -e

help()
{
    echo $'\e[33mAvailable commands:\e[0m'
    echo $'\e[32mhelp\e[0m                  List available commands'
    echo $'\e[32minstall\e[0m               Install the app'
    echo $'\e[32mstart\e[0m                 Start the containers'
    echo $'\e[32mstop\e[0m                  Stop the containers'
    echo $'\e[32mdev\e[0m                   Start the containers, clear the cache, and watch for changes'
    echo $'\e[32mformat\e[0m                Run Prettier and Laravel Pint'
    echo $'\e[32mapp <command>\e[0m         Run a command in the app container'
    echo $'\e[32mserver <command>\e[0m      Run a command in the server container'
    echo $'\e[32mdb <command>\e[0m          Run a command in the db container'
    echo $'\e[32mdb-testing <command>\e[0m  Run a command in the db-testing container'
    echo $'\e[32mmailpit <command>\e[0m     Run a command in the mailpit container'
    echo $'\e[32mredis <command>\e[0m       Run a command in the redis container'
    echo $'\e[32mhorizon <command>\e[0m     Run a command in the horizon container'
    echo $'\e[32mnpm <command>\e[0m         Run an npm command in the app container'
    echo $'\e[32mphp <command>\e[0m         Run a php command in the app container'
    echo $'\e[32mcomposer <command>\e[0m    Run a composer command in the app container'
    echo $'\e[32mvendor <executable>\e[0m   Run a vendor/bin executable in the app container'
    echo $'\e[32martisan <command>\e[0m     Run an artisan command in the app container'
    echo $'\e[32m<command>\e[0m             Run an artisan command in the app container (shorthand)'
}

install()
{

    if [ -f .env ]; then

        source .env

        if [ "production" == $APP_ENV ]; then
            echo $'\e[31mINSTALL CANCELLED. THIS IS THE PRODUCTION ENVIRONMENT.\e[0m'
            exit 1
        fi

        read -p $'\e[33mThe app has already been installed. Would you like to re-install it? y/N\e[0m' -n 1 -r

        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo
            exit 0
        fi

    fi

    cp .env.example .env

    export uid=$(id -u)
    export gid=$(id -g)
    docker compose -f docker/compose.yaml --env-file .env --profile install up --build -d

    container app composer i
    container app php artisan key:generate
    container app npm i
    container app npm run build

    until [ "`docker inspect -f {{.State.Health.Status}} laravel-vue-app-db`" == "healthy" ]; do
        sleep 1;
    done;

    container app php artisan migrate:fresh

    read -p $'Would you like to seed the database? y/N' -n 1 -r

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        container app php artisan db:seed
    fi

    start

}

start()
{
    export uid=$(id -u)
    export gid=$(id -g)
    command=$@
    docker compose -f docker/compose.yaml --env-file .env --profile "*" up -d $command
}

stop()
{
    docker compose -f docker/compose.yaml --env-file .env --profile "*" stop
}

dev()
{
    start
    container app php artisan optimize:clear
    container app NODE_ENV=development npm run dev
}

format()
{
    container app npm run prettier
    container app php vendor/bin/pint
}

container()
{
    service=$1
    command=${@:2}
    docker exec -it laravel-vue-app-$service sh -c "$command"
}

case "$1" in
    help)
        help
        ;;
    install)
        install
        ;;
    start)
        start ${@:2}
        ;;
    stop)
        stop
        ;;
    dev)
        dev
        ;;
    format)
        format
        ;;
    app | server | db | db-testing | mailpit | redis | horizon)
        container $1 ${@:2}
        ;;
    php | composer | npm)
        container app ${@:1}
        ;;  
    vendor)
        container app vendor/bin/${@:2}
        ;;
    test)
        container app XDEBUG_MODE=coverage php artisan ${@:1}
        ;;
    artisan)
        container app php ${@:1}
        ;;
    *)
        container app php artisan ${@:1}
        ;;
esac
